<script>
    (function initGustoForum() {
      // Filter chips active toggle
      const filterChips = document.querySelectorAll('.filter-chip');
      filterChips.forEach(chip => {
        chip.addEventListener('click', () => {
          filterChips.forEach(c => {
            c.classList.remove('bg-[#E09F3E]', 'text-white', 'shadow-sm');
            c.classList.add('bg-[#F3F3F3]', 'text-[#333333]');
          });
          chip.classList.remove('bg-[#F3F3F3]', 'text-[#333333]');
          chip.classList.add('bg-[#E09F3E]', 'text-white', 'shadow-sm');
        });
      });

      // Like buttons increment
      const likeButtons = document.querySelectorAll('.like-btn');
      likeButtons.forEach(btn => {
        let liked = false;
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const countSpan = btn.querySelector('.like-count');
          const icon = btn.querySelector('.material-symbols-outlined');
          let currentCount = parseInt(countSpan.textContent, 10);

          if (!liked) {
            countSpan.textContent = currentCount + 1;
            icon.textContent = 'favorite';
            icon.style.fontVariationSettings = "'FILL' 1";
            btn.classList.add('text-[#ab3333]');
            liked = true;
          } else {
            countSpan.textContent = currentCount - 1;
            icon.textContent = 'favorite_border';
            icon.style.fontVariationSettings = "'FILL' 0";
            btn.classList.remove('text-[#ab3333]');
            liked = false;
          }
        });
      });

      // Bookmark buttons toggle
      const bookmarkButtons = document.querySelectorAll('.bookmark-btn');
      bookmarkButtons.forEach(btn => {
        let saved = false;
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const icon = btn.querySelector('.material-symbols-outlined');
          if (!saved) {
            icon.textContent = 'bookmark';
            icon.style.fontVariationSettings = "'FILL' 1";
            btn.classList.add('text-[#835500]');
            saved = true;
          } else {
            icon.textContent = 'bookmark_border';
            icon.style.fontVariationSettings = "'FILL' 0";
            btn.classList.remove('text-[#835500]');
            saved = false;
          }
        });
      });

      // Follow buttons toggle
      const followButtons = document.querySelectorAll('.follow-btn');
      followButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          if (btn.textContent.trim() === 'Seguir') {
            btn.textContent = 'Siguiendo';
            btn.classList.add('bg-[#ffddb9]', 'text-[#2b1700]', 'border-transparent');
          } else {
            btn.textContent = 'Seguir';
            btn.classList.remove('bg-[#ffddb9]', 'text-[#2b1700]', 'border-transparent');
          }
        });
      });

      // Modal open/close behavior
      const modal = document.getElementById('modal-post');
      const openModalBtn = document.getElementById('btn-create-post');
      const closeModalBtn = document.getElementById('btn-close-modal');
      const cancelModalBtn = document.getElementById('btn-cancel-modal');
      const formNewPost = document.getElementById('form-new-post');

      const openModal = () => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.querySelector('.transform').classList.remove('scale-95');
        modal.querySelector('.transform').classList.add('scale-100');
      };

      const closeModal = () => {
        modal.classList.add('opacity-0', 'pointer-events-none');
        modal.querySelector('.transform').classList.remove('scale-100');
        modal.querySelector('.transform').classList.add('scale-95');
      };

      if (openModalBtn) openModalBtn.addEventListener('click', openModal);
      if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
      if (cancelModalBtn) cancelModalBtn.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });
      }

      if (formNewPost) {
        formNewPost.addEventListener('submit', (e) => {
          e.preventDefault();
          closeModal();
          alert('¡Tu publicación ha sido enviada con éxito a la comunidad Gusto!');
          formNewPost.reset();
        });
      }
    })();
  </script>
