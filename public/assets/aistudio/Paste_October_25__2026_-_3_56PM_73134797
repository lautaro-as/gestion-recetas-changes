      e.stopPropagation();
      const isLiked = this.classList.contains('active-action');
      const icon = this.querySelector('.material-symbols-outlined');
      if (!isLiked) {
        this.classList.add('active-action', 'text-[#835500]');
        if (icon) icon.style.fontVariationSettings = "'FILL' 1";
      } else {
        this.classList.remove('active-action', 'text-[#835500]');
        if (icon) icon.style.fontVariationSettings = "'FILL' 0";
      }
    });
  });

