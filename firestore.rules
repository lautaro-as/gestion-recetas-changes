rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for unspecified documents
    // (Handled by specific rules below)

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'medilautaro06@gmail.com' ||
        request.auth.token.email == 'admin@gusto.app' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Admins registry
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Recipes collection
    match /recipes/{recipeId} {
      allow read, write: if true;
    }

    // Recipe comments and ratings
    match /recipe_comments/{commentId} {
      allow read, write: if true;
    }

    // Forum topics
    match /forum_topics/{topicId} {
      allow read, write: if true;
    }

    // Forum replies
    match /forum_replies/{replyId} {
      allow read, write: if true;
    }

    // Moderation reports
    match /moderation_reports/{reportId} {
      allow read, write: if true;
    }

    // Recipe collections
    match /recipe_collections/{collectionId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
