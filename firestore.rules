rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'medilautaro06@gmail.com' ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'admin@gusto.app') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'followingUserIds'])
      );
      allow delete: if isAdmin();
    }

    // Admins registry
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Recipes collection
    match /recipes/{recipeId} {
      allow read: if resource.data.status == 'published' ||
        (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()));

      allow create: if isSignedIn() &&
        (incoming().authorId == request.auth.uid || isAdmin());

      allow update: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'likesCount',
          'dislikesCount',
          'likedUserIds',
          'dislikedUserIds',
          'commentsCount'
        ])
      );

      allow delete: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        isAdmin()
      );
    }

    // Recipe comments and ratings
    match /recipe_comments/{commentId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        incoming().authorId == request.auth.uid ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'likesCount',
          'dislikesCount',
          'likedUserIds',
          'dislikedUserIds'
        ])
      );

      allow delete: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        isAdmin()
      );
    }

    // Forum topics
    match /forum_topics/{topicId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        incoming().authorId == request.auth.uid ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'likesCount',
          'likedUserIds',
          'viewsCount',
          'repliesCount',
          'lastActivityAt'
        ])
      );

      allow delete: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        isAdmin()
      );
    }

    // Forum replies
    match /forum_replies/{replyId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        incoming().authorId == request.auth.uid ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'likesCount',
          'likedUserIds'
        ])
      );

      allow delete: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        isAdmin()
      );
    }

    // Moderation reports
    match /moderation_reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Recipe collections
    match /recipe_collections/{collectionId} {
      allow read: if resource.data.isPrivate != true ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        isAdmin();

      allow create: if isSignedIn() && (
        incoming().userId == request.auth.uid ||
        isAdmin()
      );

      allow update, delete: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn();

      allow update, delete: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
